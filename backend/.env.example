NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://orbit:orbit123@localhost:15433/orbit_db?schema=public"

JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Social login (Flutter uses Firebase Auth tokens)
FIREBASE_PROJECT_ID="orbitai-dccf8"
# Optional: path to Firebase Admin SDK JSON (for FCM send / Admin APIs later)
FIREBASE_SERVICE_ACCOUNT_PATH="./config/firebase-service-account.json"
FIREBASE_CONNECTION_PATH="./config/firebase-connection.json"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ANDROID_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""
MICROSOFT_CLIENT_ID=""
FACEBOOK_APP_ID=""

# Daily summary morning cron (user local timezone)
DAILY_SUMMARY_HOUR="7"
DAILY_SUMMARY_MINUTE="0"

# OpenAI (unified chat agent + travel web search)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Optional: model used only for hotel/flight web_search (defaults to OPENAI_MODEL)
OPENAI_SEARCH_MODEL=""

# Seed credentials (used by prisma/seed.ts)
SUPERADMIN_EMAIL="superadmin@orbit.local"
SUPERADMIN_PASSWORD="SuperAdmin@123"
SUPERADMIN_NAME="Orbit Super Admin"

# Public base URL for absolute avatar/upload links
PUBLIC_BASE_URL=http://187.77.175.27

# Brevo SMTP — email OTP on register (Dashboard → SMTP & API → SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=""
BREVO_SMTP_KEY=""
BREVO_FROM_EMAIL="support@orbit.ai"
BREVO_FROM_NAME=ORBIT
OTP_EXPIRES_MINUTES=10

# Contact Support admin inbox (receives POST /api/support/contact)
SUPPORT_ADMIN_EMAIL="admin@example.com"
