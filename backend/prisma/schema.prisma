generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
  MICROSOFT
}

enum InterestCategory {
  TRAVEL
  BUSINESS
  HEALTH
  FINANCE
  PRODUCTIVITY
  DOCUMENTS
  FITNESS
  FOOD
  TECHNOLOGY
  EDUCATION
  LIFESTYLE
  OTHER
}

enum ConversationType {
  GENERAL
  MEDICAL
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum ReminderType {
  MEDICINE
  APPOINTMENT
  TASK
  GENERAL
  TRAVEL
}

enum ReminderRecurrence {
  ONCE
  DAILY
  WEEKLY
}

enum ReminderLogStatus {
  TAKEN
  SKIPPED
  SNOOZED
}

enum HealthDocumentCategory {
  LAB
  PRESCRIPTION
  IMAGING
  OTHER
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum AttachmentKind {
  IMAGE
  DOCUMENT
}

enum ExtractStatus {
  PENDING
  READY
  FAILED
  SKIPPED
}

enum TravelCabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

enum TravelOfferKind {
  HOTEL
  FLIGHT
}

enum TripStatus {
  DRAFT
  PLANNED
  READY_TO_BOOK
  CANCELLED
}

enum BudgetEntryType {
  INCOME
  EXPENSE
}

enum FinanceMarket {
  ADX
  OTHER
}

enum FinanceAlertCondition {
  ABOVE
  BELOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskContext {
  PERSONAL
  BUSINESS
}

enum BusinessNoteKind {
  NOTE
  CHECKLIST
  RESEARCH
  PLAN
}

enum EmailOtpPurpose {
  REGISTER
  PASSWORD_RESET
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String?
  fullName         String
  avatarUrl        String?
  role             Role             @default(USER)
  isActive         Boolean          @default(true)
  emailVerifiedAt  DateTime?
  marketingOptIn   Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  socialAccounts   SocialAccount[]
  profile          UserProfile?
  medicalProfile   MedicalProfile?
  conversations    Conversation[]
  chatFolders      ChatFolder[]
  reminders        Reminder[]
  reminderLogs     ReminderLog[]
  symptomEntries   SymptomEntry[]
  healthDocuments  HealthDocument[]
  deviceTokens     DeviceToken[]
  travelPreferences TravelPreferences?
  trips             Trip[]
  travelOffers      TravelOffer[]
  budgetEntries     BudgetEntry[]
  watchlistItems    WatchlistItem[]
  financeAlerts     FinanceAlert[]
  tasks             Task[]
  calendarEvents    CalendarEvent[]
  googleCalendar    GoogleCalendarConnection?
  dailySummaries    DailySummary[]
  businessNotes     BusinessNote[]
  healthChecks      HealthCheckResult[]
  stripeCustomerId  String?           @unique
  subscription      UserSubscription?
  creditAccount     UserCreditAccount?
  creditLedger      CreditLedgerEntry[]

  @@map("users")
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
  TRIALING
  EXPIRED
}

enum CreditReason {
  SIGNUP_BONUS
  SUBSCRIPTION_GRANT
  CHAT_SPEND
  REFUND
  ADJUSTMENT
  PERIOD_RESET
}

/// Catalog plan (Basic / Plus / Pro). Prices live in PlanPrice (monthly + yearly).
model SubscriptionPlan {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  description String?
  sortOrder   Int                @default(0)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  prices      PlanPrice[]
  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model PlanPrice {
  id               String          @id @default(cuid())
  planId           String
  plan             SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  interval         BillingInterval
  amountCents      Int
  currency         String          @default("usd")
  /// Credits granted at start of each billing period
  creditsPerPeriod Int
  stripePriceId    String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([planId, interval])
  @@map("plan_prices")
}

model UserSubscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id])
  priceId              String?
  status               SubscriptionStatus @default(INCOMPLETE)
  interval             BillingInterval
  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status])
  @@map("user_subscriptions")
}

model UserCreditAccount {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("user_credit_accounts")
}

model CreditLedgerEntry {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta        Int
  reason       CreditReason
  balanceAfter Int
  reference    String?
  meta         Json?
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([reason, createdAt])
  @@map("credit_ledger")
}

/// Pending email OTP (e.g. register). Payload holds signup fields until verified.
model EmailOtp {
  id        String          @id @default(cuid())
  email     String
  purpose   EmailOtpPurpose
  codeHash  String
  payload   Json?
  expiresAt DateTime
  attempts  Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([email, purpose])
  @@index([expiresAt])
  @@map("email_otps")
}

model SocialAccount {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       AuthProvider
  providerUserId String
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("social_accounts")
}

model UserProfile {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String?
  timezone    String             @default("Asia/Dubai")
  bio         String?
  dateOfBirth DateTime?
  age         Int?
  gender      String?
  language    String             @default("en")
  country     String?
  city        String?
  residence   String?
  currency    String?
  hobby       String?
  interests   InterestCategory[] @default([])
  /// Category → multiple values, e.g. { "travel": ["beach","family"], "food": ["halal"] }
  preferences Json               @default("{}")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("user_profiles")
}

/// Lightweight medical context for reminders/docs — not a clinical record.
model MedicalProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentSituation      String?
  conditions            String[] @default([])
  allergies             String[] @default([])
  currentMedications    String[] @default([])
  bloodType             String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("medical_profiles")
}

/// Main-page wellness health check (not a clinical diagnosis).
model HealthCheckResult {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version     String   @default("v1")
  answers     Json
  score       Int
  maxScore    Int
  level       String
  tips        String[] @default([])
  summary     String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@map("health_check_results")
}

/// Sidebar folder (ChatGPT-style) — organization only; AI routing is unchanged.
model ChatFolder {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]

  @@index([userId, sortOrder])
  @@unique([userId, name])
  @@map("chat_folders")
}

model Conversation {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId  String?
  folder    ChatFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  title     String?
  type      ConversationType @default(MEDICAL)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  Message[]

  @@index([userId, updatedAt])
  @@index([userId, folderId])
  @@map("conversations")
}

model Message {
  id             String              @id @default(cuid())
  conversationId String
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  metadata       Json?
  createdAt      DateTime            @default(now())
  attachments    MessageAttachment[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id              String        @id @default(cuid())
  messageId       String
  message         Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind            AttachmentKind
  originalName    String
  mimeType        String
  byteSize        Int
  storagePath     String
  publicUrl       String?
  extractStatus   ExtractStatus @default(PENDING)
  extractedText   String?
  extractError    String?
  healthDocumentId String?
  healthDocument  HealthDocument? @relation(fields: [healthDocumentId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  @@index([messageId])
  @@map("message_attachments")
}

model Reminder {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ReminderType       @default(MEDICINE)
  title       String
  description String?
  medicineName String?
  dosage      String?
  remindAt    DateTime
  lastFiredAt DateTime?
  recurrence  ReminderRecurrence @default(ONCE)
  timesOfDay  String[]           @default([])
  timezone    String             @default("Asia/Dubai")
  isActive    Boolean            @default(true)
  isCompleted Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  logs        ReminderLog[]

  @@index([userId, remindAt])
  @@index([userId, type, isActive])
  @@index([isActive, isCompleted, remindAt])
  @@map("reminders")
}

model ReminderLog {
  id         String            @id @default(cuid())
  reminderId String
  reminder   Reminder          @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     ReminderLogStatus
  takenAt    DateTime          @default(now())
  note       String?
  createdAt  DateTime          @default(now())

  @@index([reminderId, takenAt])
  @@index([userId, takenAt])
  @@map("reminder_logs")
}

model SymptomEntry {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordedAt         DateTime @default(now())
  symptoms           String[] @default([])
  severity           Int
  notes              String?
  relatedMedications String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, recordedAt])
  @@map("symptom_entries")
}

model HealthDocument {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  category        HealthDocumentCategory @default(OTHER)
  fileUrl         String?
  storagePath     String?
  mimeType        String?
  byteSize        Int?
  extractStatus   ExtractStatus          @default(SKIPPED)
  extractedText   String?
  notes           String?
  recordedAt      DateTime               @default(now())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  attachments     MessageAttachment[]

  @@index([userId, recordedAt])
  @@map("health_documents")
}

model DeviceToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  platform  DevicePlatform
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, token])
  @@index([userId])
  @@map("device_tokens")
}

/// User travel defaults used by chat when searching hotels/flights.
model TravelPreferences {
  id                   String           @id @default(cuid())
  userId               String           @unique
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeCity             String?
  homeCountry          String?
  homeAirport          String?
  preferredCurrency    String           @default("AED")
  maxHotelBudget       Float?
  maxFlightBudget      Float?
  preferredHotelStars  Int?
  preferredAirlines    String[]         @default([])
  cabinClass           TravelCabinClass @default(ECONOMY)
  preferRefundable     Boolean          @default(false)
  adultsDefault        Int              @default(1)
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@map("travel_preferences")
}

/// Saved trip plan (itinerary shell for flights/hotels).
model Trip {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  destination   String
  origin        String?
  startDate     DateTime?
  endDate       DateTime?
  adults        Int        @default(1)
  budget        Float?
  currency      String     @default("AED")
  status        TripStatus @default(DRAFT)
  notes         String?
  /// e.g. family | adventure | relaxation | business
  purpose       String?
  /// Selected multi-day itinerary plan (JSON)
  itinerary     Json?
  /// [{ category, amount, currency?, note?, at? }]
  expenseLog    Json       @default("[]")
  selectedHotelOfferId  String?
  selectedFlightOfferId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  offers        TravelOffer[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("trips")
}

/// Normalized hotel/flight option from search (for compare + recommend + trip link).
model TravelOffer {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId          String?
  trip            Trip?           @relation(fields: [tripId], references: [id], onDelete: SetNull)
  kind            TravelOfferKind
  title           String
  bookingUrl      String
  snippet         String?
  source          String?
  price           Float?
  currency        String?
  stars           Int?
  airline         String?
  durationMinutes Int?
  stops           Int?
  score           Float?
  isRecommended   Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, kind, createdAt])
  @@index([tripId])
  @@map("travel_offers")
}

model BudgetEntry {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       BudgetEntryType
  category   String
  amount     Float
  currency   String          @default("AED")
  note       String?
  occurredAt DateTime        @default(now())
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId, occurredAt])
  @@index([userId, type, category])
  @@map("budget_entries")
}

model WatchlistItem {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  market      FinanceMarket    @default(OTHER)
  displayName String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  alerts      FinanceAlert[]

  @@unique([userId, symbol])
  @@index([userId, market])
  @@map("watchlist_items")
}

model FinanceAlert {
  id              String                @id @default(cuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchlistItemId String?
  watchlistItem   WatchlistItem?        @relation(fields: [watchlistItemId], references: [id], onDelete: SetNull)
  symbol          String
  condition       FinanceAlertCondition
  threshold       Float
  currency        String?               @default("AED")
  isActive        Boolean               @default(true)
  lastTriggeredAt DateTime?
  lastPrice       Float?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([userId, isActive])
  @@index([symbol, isActive])
  @@map("finance_alerts")
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  context     TaskContext  @default(PERSONAL)
  dueAt       DateTime?
  completedAt DateTime?
  tags        String[]     @default([])
  reminderId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, status, dueAt])
  @@index([userId, context, status])
  @@index([userId, createdAt])
  @@map("tasks")
}

model BusinessNote {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  body           String?
  kind           BusinessNoteKind @default(NOTE)
  /// Checklist items: [{ "text": "...", "done": false }]
  checklistItems Json?
  tags           String[]         @default([])
  sourceUrls     String[]         @default([])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId, kind, createdAt])
  @@map("business_notes")
}

model CalendarEvent {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  location         String?
  startAt          DateTime
  endAt            DateTime?
  allDay           Boolean  @default(false)
  reminderId       String?
  /// google | null (ORBIT-only)
  externalProvider String?
  externalEventId  String?
  externalEtag     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, externalProvider, externalEventId])
  @@index([userId, startAt])
  @@map("calendar_events")
}

/// Cached morning digest (one row per user per local calendar day).
model DailySummary {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Local calendar date YYYY-MM-DD
  date        String
  timezone    String   @default("Asia/Dubai")
  payload     Json
  pushSentAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, createdAt])
  @@map("daily_summaries")
}

/// Google Calendar OAuth tokens for a user (one primary calendar connection).
model GoogleCalendarConnection {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail  String?
  calendarId   String    @default("primary")
  accessToken  String?
  refreshToken String
  tokenExpiry  DateTime?
  scopes       String?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("google_calendar_connections")
}
