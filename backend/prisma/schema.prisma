generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
  MICROSOFT
}

enum InterestCategory {
  TRAVEL
  BUSINESS
  HEALTH
  FINANCE
  PRODUCTIVITY
  DOCUMENTS
  FITNESS
  FOOD
  TECHNOLOGY
  EDUCATION
  LIFESTYLE
  OTHER
}

enum ConversationType {
  GENERAL
  MEDICAL
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum ReminderType {
  MEDICINE
  APPOINTMENT
  TASK
  GENERAL
}

enum ReminderRecurrence {
  ONCE
  DAILY
  WEEKLY
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String?
  fullName       String
  avatarUrl      String?
  role           Role            @default(USER)
  isActive       Boolean         @default(true)
  marketingOptIn Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  socialAccounts SocialAccount[]
  profile        UserProfile?
  medicalProfile MedicalProfile?
  conversations  Conversation[]
  reminders      Reminder[]

  @@map("users")
}

model SocialAccount {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       AuthProvider
  providerUserId String
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("social_accounts")
}

model UserProfile {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone       String?
  timezone    String             @default("Asia/Dubai")
  bio         String?
  dateOfBirth DateTime?
  gender      String?
  language    String             @default("en")
  country     String?
  city        String?
  interests   InterestCategory[] @default([])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("user_profiles")
}

/// Lightweight medical context for reminders/docs — not a clinical record.
model MedicalProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentSituation      String?
  conditions            String[] @default([])
  allergies             String[] @default([])
  currentMedications    String[] @default([])
  bloodType             String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("medical_profiles")
}

model Conversation {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  type      ConversationType @default(MEDICAL)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  Message[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Reminder {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         ReminderType       @default(MEDICINE)
  title        String
  description  String?
  medicineName String?
  dosage       String?
  remindAt     DateTime
  recurrence   ReminderRecurrence @default(ONCE)
  timesOfDay   String[]           @default([])
  timezone     String             @default("Asia/Dubai")
  isActive     Boolean            @default(true)
  isCompleted  Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([userId, remindAt])
  @@index([userId, type, isActive])
  @@map("reminders")
}
